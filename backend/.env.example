# 本地开发配置：复制为 backend/.env 后填写。Docker 部署请改用 deploy/.env。

# 生成方式：python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=oj
MYSQL_USER=oj
MYSQL_PASSWORD=

REDIS_URL=redis://127.0.0.1:6379

# 与判题服务器容器的 TOKEN 一致
JUDGE_SERVER_TOKEN=
