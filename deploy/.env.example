# Docker 部署配置。运行 ./init-env.sh 会复制为 .env 并自动生成各项密钥。

# Nginx 对外端口
OJ_HTTP_PORT=80

MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=oj
MYSQL_USER=oj
MYSQL_PASSWORD=

DJANGO_SECRET_KEY=
DJANGO_DEBUG=false
# 加上服务器的域名或 IP；backend 供判题服务器容器内部访问
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
# 例如 https://oj.example.edu.cn
DJANGO_CSRF_TRUSTED_ORIGINS=

# 判题服务器通信令牌
JUDGE_SERVER_TOKEN=

GUNICORN_WORKERS=4
CELERY_CONCURRENCY=4
